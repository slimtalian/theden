{
  "name": "the-den",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A quiet, local-first bookshelf for PDFs and EPUBs. Calibre library management, tactile book previews, and PDF.js reading.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:demo": "node --test tests/demo.test.mjs tests/reader-gestures.test.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "node scripts/preview-demo.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/slimtalian/theden.git"
  },
  "homepage": "https://slimtalian.github.io/theden/"
}
